# =========================
# shopdb2 MySQL
# =========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shopdb2
DB_USER=shopdbid2
DB_PASSWORD=shopdbid2
DB_CHARSET=utf8mb4

# =========================
# JWT / Security
# 운영환경에서는 반드시 긴 랜덤 문자열로 교체하세요.
# =========================
JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# API
# =========================
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
